# Ryuki Infrastructure Platform — Environment Configuration
# All variables use RYUKI_ prefix with __ (double underscore) for nested fields.
# Example: server.bind_address → RYUKI_SERVER__BIND_ADDRESS
# Priority: env vars > config file > defaults

# Mandatory deployment-security admission inputs. The contract root must be an
# absolute, immutable directory containing the referenced profile, trust-root
# registry, and every content-addressed dependency. Supply the remaining values
# explicitly for the exact deployment being started; startup never infers or
# defaults them. Both relative paths must be normalized `.json` paths, and both
# digests must be nonzero lowercase `sha256:<64hex>` values over the exact bytes.
RYUKI_SECURITY_CONTRACT_ROOT=/absolute/path/to/ryuki.io
RYUKI_DEPLOYMENT_SECURITY_PROFILE_PATH=
RYUKI_DEPLOYMENT_SECURITY_PROFILE_DIGEST=
RYUKI_CONFORMANCE_TRUST_ROOT_REGISTRY_PATH=
RYUKI_CONFORMANCE_TRUST_ROOT_REGISTRY_DIGEST=
RYUKI_EXPECTED_DEPLOYMENT_ID=
RYUKI_SECURITY_PROFILE=

# Database
RYUKI_DATABASE_URL=postgres://ryuki:ryuki_dev@localhost:5432/ryuki_platform
# Migration ownership is always explicit. This reference file is for the local
# developer database, where startup may apply the embedded inventory directly.
RYUKI_MIGRATION_MODE=local-auto
# Fail hard when the database is unreachable at startup (exit non-zero instead
# of falling back to in-memory stores). Default false for local dev; set true
# in deployed environments (K8s ConfigMap and compose set it).
# RYUKI_DATABASE__REQUIRED=false

# Server (nested via __)
# Credential-free mock/static authentication is local-only; use a real
# authenticator before selecting a non-loopback listener.
# RYUKI_SERVER__BIND_ADDRESS=127.0.0.1:8080
# RYUKI_SERVER__SHUTDOWN_TIMEOUT_SECS=30
# RYUKI_SERVER__REQUEST_TIMEOUT_SECS=30
# RYUKI_SERVER__MAX_BODY_SIZE_BYTES=10485760
# RYUKI_SERVER__POOL_MAX_CONNECTIONS=5
# RYUKI_SERVER__POOL_MIN_CONNECTIONS=2
# RYUKI_SERVER__POOL_IDLE_TIMEOUT_SECS=300
# RYUKI_SERVER__POOL_ACQUIRE_TIMEOUT_SECS=30
# RYUKI_SERVER__POOL_MAX_LIFETIME_SECS=1800
# RYUKI_SERVER__TLS_CERT_PATH=/etc/ssl/certs/server.crt
# RYUKI_SERVER__TLS_KEY_PATH=/etc/ssl/private/server.key
# RYUKI_SERVER__COMPRESSION_QUALITY=6      # 0-9
# RYUKI_SERVER__KEEP_ALIVE_TIMEOUT_SECS=75
# RYUKI_SERVER__MAX_CONCURRENT_CONNECTIONS=512

# Auth: mock-dry-run | static-dry-run | entra-id | local
RYUKI_AUTH_MODE=mock-dry-run
RYUKI_ENTRA_TENANT_ID=
RYUKI_ENTRA_CLIENT_ID=
RYUKI_ENTRA_AUTHORITY=https://login.microsoftonline.com
# Browser authorization-code callback. Leave empty only for deliberate
# bearer-token-only Entra use; Entra mode still requires the session verifier.
# RYUKI_ENTRA_REDIRECT_URI=https://portal.example.test/api/auth/entra/callback
# Entra signing-key cache lifetime must be 1..=86400 seconds.
# RYUKI_ENTRA_JWKS_TTL_SECS=86400
# Token exp/nbf clock leeway must be 0..=300 seconds.
# RYUKI_ENTRA_LEEWAY_SECS=60

# Current single-provider generic OIDC authorization-code + PKCE flow. This is
# separate from RYUKI_AUTH_MODE while the multi-provider registry in the
# platform security boundary specification is implemented. Every endpoint is
# HTTPS outside explicit loopback tests, and the client secret must be injected
# at runtime rather than committed here.
# RYUKI_OIDC__ENABLED=false
# RYUKI_OIDC__ISSUER=https://identity.example.test
# RYUKI_OIDC__AUTHORIZE_ENDPOINT=https://identity.example.test/authorize
# RYUKI_OIDC__TOKEN_ENDPOINT=https://identity.example.test/token
# RYUKI_OIDC__JWKS_URI=https://identity.example.test/jwks
# RYUKI_OIDC__CLIENT_ID=
# RYUKI_OIDC__CLIENT_SECRET=
# RYUKI_OIDC__REDIRECT_URI=https://portal.example.test/api/auth/oidc/callback
# RYUKI_OIDC__SCOPES=["openid","profile","email"]
# RYUKI_OIDC__ROLES_CLAIM=roles

# Local authentication (defensive auth for self-hosted deployments)
# Honored only when RYUKI_AUTH_MODE=local (required and validated at startup
# in that mode; ignored with a warning otherwise).
# Format: comma-separated entries of username:password:Role|Role # secret-scan-allow
#   - exactly 3 ':'-separated fields per entry (passwords must not contain ':')
#   - username: A-Z a-z 0-9 . _ - (unique, case-sensitive)
#   - password: min 8 characters (never echoed in logs or config dumps)
#   - roles: one or more existing app roles separated by '|'
#     (PlatformAdmin, DatacenterApprover, VMwareOperator, HyperVOperator,
#      ProxmoxOperator, WintelLinuxOperator, BackupOperator,
#      MonitoringOperator, ServiceDesk, Auditor, Requester, BreakGlassAdmin)
# Placeholder credentials only — NEVER commit real credentials.
# RYUKI_LOCAL_AUTH__USERS=alice:change-me-password:PlatformAdmin,bob:change-me-password:VMwareOperator|Auditor # secret-scan-allow
# Interactive authority is never inferred from an empty scope. Set each axis
# explicitly to `global` (with an empty value list) or `scoped` (with one or
# more comma-separated canonical identifiers). `unknown` is the fail-closed
# default and prevents a populated local configuration from starting.
# RYUKI_LOCAL_AUTH__SITE_AUTHORITY=global
# RYUKI_LOCAL_AUTH__SITE_SCOPE=
# RYUKI_LOCAL_AUTH__ENVIRONMENT_AUTHORITY=global
# RYUKI_LOCAL_AUTH__ENVIRONMENT_SCOPE=

# Session cookies are Secure by default, which browsers drop over plain HTTP.
# For plain-HTTP local dev, set both RYUKI_PLATFORM_URL to a literal loopback
# HTTP origin and this value to false in your gitignored .env. Startup rejects
# false for HTTPS and every non-loopback public origin.
# RYUKI_SESSION__COOKIE_SECURE=false

# Portal → API upstream and portal runtime mode
# RYUKI_API_URL=http://127.0.0.1:8081
# Exact browser origin admitted for unsafe `/portal/api/*` requests. HTTPS is
# required outside explicitly enabled loopback development.
# RYUKI_PORTAL_PUBLIC_ORIGIN=https://portal.example.test
# RYUKI_PORTAL_ALLOW_INSECURE_LOOPBACK=false
# Bounded portal server-function ingress (hard safety ceilings also apply).
# RYUKI_PORTAL_SERVER_FN_MAX_BODY_BYTES=10485760
# RYUKI_PORTAL_SERVER_FN_MAX_CONCURRENT_REQUESTS=128
# RYUKI_PORTAL_SERVER_FN_REQUEST_TIMEOUT_SECS=30
# Portal execution mode: static-dry-run (GitHub Pages demo, default) or
# live-provider (talks to the API above).
# RYUKI_PORTAL_EXECUTION_MODE=static-dry-run
# Portal-origin cookie security is derived from RYUKI_PORTAL_PUBLIC_ORIGIN:
# HTTPS always emits Secure cookies; only explicitly enabled loopback HTTP does
# not. This optional value is an assertion and must match the derived policy.
# RYUKI_PORTAL_COOKIE_SECURE=true

# Platform identity
RYUKI_PLATFORM_NAME="Ryuki Infrastructure Platform"
RYUKI_PLATFORM_URL=http://localhost:18080

# Infrastructure providers
# Direct-host live agents also require a stable, non-secret reference to their
# exact vSphere destination/account credential set. Keep these empty for
# dry-run. The id is an opaque provisioning-record reference, never provider
# data; rotate the version whenever any destination/account/credential member
# changes. Provider credentials remain separate runtime-only values.
# RYUKI_LIVE_PROVIDER_AUTHORITY_ID=
# RYUKI_LIVE_PROVIDER_AUTHORITY_VERSION=
# Live agents also require a stable, non-secret reference to the exact backend
# credential/destination authority. The id is kind-scoped; rotate the revision
# whenever its principal, destination, or credential set changes.
# RYUKI_LIVE_BACKEND_CREDENTIAL_AUTHORITY_ID=
# RYUKI_LIVE_BACKEND_CREDENTIAL_AUTHORITY_REVISION=
# Database: cloudnativepg | postgres-local | aws-rds | azure-postgresql | gcp-cloud-sql
RYUKI_DATABASE_PROVIDER=cloudnativepg
# Secrets: hashicorp-vault | aws-secrets-manager | azure-key-vault | gcp-secret-manager | bitwarden-secrets-manager | none
RYUKI_SECRET_PROVIDER=hashicorp-vault
# Current Vault adapter for the provider-neutral secret-resolution boundary.
# VAULT_ADDR and VAULT_TOKEN are all-or-none startup configuration. Production
# uses HTTPS and a workload-authenticated, least-privilege token delivered at
# runtime; the cleartext exception accepts an IP-literal loopback address only.
# VAULT_ADDR=https://vault.example.test:8200
# VAULT_TOKEN=
# RYUKI_VAULT_ALLOW_INSECURE_LOOPBACK=false
# Envelope key for persisted integration credentials: exactly 32 bytes encoded
# as canonical base64 or 64 hex characters, supplied only at runtime.
# RYUKI_INTEGRATION__ENCRYPTION_KEY=
# Durable control-plane grant-signing key path. The file and its parent must be
# owned and protected by the deployment's secret/key delivery mechanism.
# RYUKI_CP_SIGNING_KEY_PATH=/run/secrets/ryuki/cp-signing.key
# Kubernetes: vsphere-vks | docker-compose | aks | eks | gke | openshift | rancher | none
RYUKI_KUBERNETES_RUNTIME=vsphere-vks
# Hypervisor: vmware | hyperv | proxmox | nutanix-ahv | xen | kvm | none
RYUKI_HYPERVISOR_PROVIDER=vmware
# Monitoring: zabbix | prometheus | datadog | grafana | solarwinds | none
RYUKI_MONITORING_PROVIDER=zabbix
# Backup: veeam | commvault | rubrik | cohesity | netbackup | none
RYUKI_BACKUP_PROVIDER=veeam
# Storage: netapp | pure-storage | dell-powerstore | hpe-alletra | azure-blob | none
RYUKI_STORAGE_PROVIDER=none
# DNS: infoblox | bluecat | windows-dns | route53 | none
RYUKI_DNS_PROVIDER=none
# IPAM: infoblox | phpipam | netbox | none
RYUKI_IPAM_PROVIDER=none
# Load Balancer: f5-bigip | citrix-adc | haproxy | nginx | none
RYUKI_LOAD_BALANCER_PROVIDER=none
# Firewall: palo-alto | checkpoint | fortinet | cisco-asa | none
RYUKI_FIREWALL_PROVIDER=none
# Build/CI-CD: jenkins | github-actions | azure-devops | argocd | none
RYUKI_BUILD_PROVIDER=none
# Network/SDN: cisco-aci | vmware-nsx | evpn | none
RYUKI_NETWORK_PROVIDER=none

# CORS (nested via __)
# RYUKI_CORS__ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# RYUKI_CORS__MAX_AGE_SECS=3600

# Rate limiting (nested via __)
# RYUKI_RATE_LIMIT__ENABLED=false
# RYUKI_RATE_LIMIT__REQUESTS_PER_SECOND=50
# RYUKI_RATE_LIMIT__BURST_SIZE=100
# Trusted reverse proxies (plain IPs or CIDR blocks, JSON array like CORS).
# Rate limiting keys on the connecting peer address; X-Forwarded-For is only
# honored when the peer matches one of these networks, taking the rightmost
# entry that is not itself a trusted proxy. Default empty: never trust XFF.
# RYUKI_RATE_LIMIT__TRUSTED_PROXIES=["127.0.0.1","10.0.0.0/8"]

# Per-path rate limit overrides (higher quota for health/metrics endpoints)
# RYUKI_RATE_LIMIT__PATH_OVERRIDES__HEALTH__REQUESTS_PER_SECOND=10
# RYUKI_RATE_LIMIT__PATH_OVERRIDES__HEALTH__BURST_SIZE=5

# Logging (nested via __)
# RYUKI_LOGGING__LEVEL=info         # trace | debug | info | warn | error
# RYUKI_LOGGING__FORMAT=text        # text | json

# Extended logging (file output + retention)
# RYUKI_LOG_EXTENDED__FILE_PATH=/var/log/ryuki-api.log
# RYUKI_LOG_EXTENDED__RETENTION_DAYS=30

# Security headers (nested via __)
# RYUKI_SECURITY__CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'
# RYUKI_SECURITY__HSTS_ENABLED=false
# RYUKI_SECURITY__HSTS_MAX_AGE_SECS=31536000

# SMTP / Email notifications (nested via __)
# RYUKI_SMTP__ENABLED=false
# RYUKI_SMTP__HOST=localhost
# RYUKI_SMTP__PORT=587
# RYUKI_SMTP__USERNAME=
# RYUKI_SMTP__PASSWORD=
# RYUKI_SMTP__FROM_ADDRESS=ryuki@localhost
# RYUKI_SMTP__USE_TLS=true

# Session cookie config (nested via __)
# Required when local, Entra, or generic OIDC can mint persisted sessions.
# Inject at runtime from the selected secret manager; use at least 32 random
# bytes (for example: openssl rand -base64 48). Never commit the value.
# Rotating this single active key intentionally signs out every active session.
# RYUKI_SESSION__CREDENTIAL_HMAC_KEY=
# RYUKI_SESSION__COOKIE_MAX_AGE_SECS=86400
# Maximum age of the last validated federated assertion/lifecycle heartbeat.
# Persisted Entra/OIDC sessions fail closed after this interval (default 15m,
# maximum 1h).
# RYUKI_SESSION__FEDERATED_AUTHORITY_MAX_STALENESS_SECS=900
# RYUKI_SESSION__COOKIE_SECURE=true
# RYUKI_SESSION__COOKIE_HTTP_ONLY=true
# RYUKI_SESSION__COOKIE_SAME_SITE=lax       # lax | strict | none

# Backup retention (nested via __)
# RYUKI_RETENTION__DAILY_BACKUPS=30       # days to keep daily backups
# RYUKI_RETENTION__WEEKLY_BACKUPS=12      # weeks to keep weekly backups
# RYUKI_RETENTION__MONTHLY_BACKUPS=12     # months to keep monthly backups
# RYUKI_RETENTION__YEARLY_BACKUPS=7       # years to keep yearly backups

# Maintenance window (nested via __)
# RYUKI_MAINTENANCE_WINDOW__ENABLED=false
# RYUKI_MAINTENANCE_WINDOW__DAY_OF_WEEK=sunday     # sunday-saturday
# RYUKI_MAINTENANCE_WINDOW__START_HOUR_UTC=2       # 0-23 (2 = 2 AM UTC)
# RYUKI_MAINTENANCE_WINDOW__DURATION_HOURS=4
