# PostgreSQL
DATABASE_URL=postgres://ryuki:ryuki_dev@localhost:5432/ryuki_platform

# Entra ID (Microsoft)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUTHORITY=https://login.microsoftonline.com

# Platform
PLATFORM_NAME=Ryuki Infrastructure Platform
PLATFORM_URL=http://localhost:18080
AUTH_MODE=mock-dry-run

# Infrastructure providers (informational)
# Database: cloudnativepg | postgres-local | aws-rds | azure-postgresql | gcp-cloud-sql
DATABASE_PROVIDER=cloudnativepg
# Secrets: hashicorp-vault | aws-secrets-manager | azure-key-vault | gcp-secret-manager | none
SECRET_PROVIDER=hashicorp-vault
# Kubernetes: vsphere-vks | docker-compose | aks | eks | gke | openshift | rancher | none
KUBERNETES_RUNTIME=vsphere-vks
# Hypervisor: vmware | hyperv | proxmox | nutanix-ahv | xen | kvm | none
HYPERVISOR_PROVIDER=vmware
# Monitoring: zabbix | prometheus | datadog | grafana | solarwinds | none
MONITORING_PROVIDER=zabbix
# Backup: veeam | commvault | rubrik | cohesity | netbackup | none
BACKUP_PROVIDER=veeam
