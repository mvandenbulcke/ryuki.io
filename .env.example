# Ryuki Infrastructure Platform — Environment Configuration
# All variables use RYUKI_ prefix with __ (double underscore) for nested fields.
# Example: server.bind_address → RYUKI_SERVER__BIND_ADDRESS
# Priority: env vars > config file > defaults

# Mandatory deployment-security admission inputs. The contract root must be an
# absolute, immutable directory containing the referenced profile, trust-root
# registry, and every content-addressed dependency. Supply the remaining values
# explicitly for the exact deployment being started; startup never infers or
# defaults them. Both relative paths must be normalized `.json` paths, and both
# digests must be nonzero lowercase `sha256:<64hex>` values over the exact bytes.
# The trust-registry pair selects the current lineage head; every exact
# predecessor through version 1 must also exist under this root. The chain is
# not an external monotonic rollback checkpoint, so it cannot enable production.
RYUKI_SECURITY_CONTRACT_ROOT=/absolute/path/to/ryuki.io
RYUKI_DEPLOYMENT_SECURITY_PROFILE_PATH=
RYUKI_DEPLOYMENT_SECURITY_PROFILE_DIGEST=
RYUKI_CONFORMANCE_TRUST_ROOT_REGISTRY_PATH=
RYUKI_CONFORMANCE_TRUST_ROOT_REGISTRY_DIGEST=
RYUKI_EXPECTED_DEPLOYMENT_ID=
RYUKI_SECURITY_PROFILE=

# Production-only build-identity and applicability binding. Configure PATH and
# DIGEST together; a partial pair fails closed, and the complete pair is
# mandatory when RYUKI_SECURITY_PROFILE=production. PATH is a normalized
# absolute `.json` path detached from the rollbackable security-contract root.
# DIGEST is the nonzero lowercase `sha256:<64hex>` digest of the manifest's
# exact raw bytes. Startup independently derives the complete applicability
# inventory and consumes this binding with the checkpoint, semantic closure,
# pinned profile, and deployed-workload proof into one non-cloneable boundary.
# Live witnesses now cover `HttpsPublicUrls`, `SecureCookies`,
# `ApprovedSecretProvider`, `NonDevelopmentAuthenticator`, `DurablePostgresql`,
# and `FirstOwnerPathClosed`. Production remains blocked on exactly two guards:
# external-signing-key-material and mock-dependencies-disabled. The overall
# proposed normative production boundary is not complete; the closed-state
# witness does not complete the broader SB-BOOT/AC-023 bootstrap, transfer,
# recovery, and break-glass acceptance program.
# RYUKI_PRODUCTION_BUILD_MANIFEST_PATH=
# RYUKI_PRODUCTION_BUILD_MANIFEST_DIGEST=

# Production-only external conformance trust-checkpoint bindings. Provision
# every value from a separately governed workload/deployment trust channel;
# never derive or copy them from the rollbackable contract root, profile,
# registry, or a conformance document. The public key is canonical Base64 of
# exactly 32 raw Ed25519 bytes and the fingerprint is SHA-256 of those decoded
# bytes. SOCKET is an absolute, lexically normalized Unix-socket path with a
# file name, no NUL, and at most 103 path bytes. AUTHORITY_ID begins
# `conformance-trust-checkpoint-authority:` and KEY_ID begins
# `conformance-trust-checkpoint-key:`. MIN_AUTHORITY_EPOCH is an independently
# held fencing floor. Startup performs read-only exact-head reconciliation and
# never bootstraps or advances authority state; an operator-owned exact
# compare-and-swap workflow is separate.
# RYUKI_CONFORMANCE_TRUST_CHECKPOINT_SOCKET=
# RYUKI_CONFORMANCE_TRUST_CHECKPOINT_AUTHORITY_ID=
# RYUKI_CONFORMANCE_TRUST_CHECKPOINT_KEY_ID=
# RYUKI_CONFORMANCE_TRUST_CHECKPOINT_PUBLIC_KEY_BASE64=
# RYUKI_CONFORMANCE_TRUST_CHECKPOINT_PUBLIC_KEY_FINGERPRINT=
# RYUKI_CONFORMANCE_TRUST_CHECKPOINT_MIN_AUTHORITY_EPOCH=

# Production-only deployed-workload attestation binding. Configure all ten
# values together; a partial group fails closed. The complete group is
# mandatory for production alongside the build-manifest and conformance
# trust-checkpoint pins. Development and test profiles must leave every value
# below unset. Provision the authority, key, fingerprint, measurement profile,
# and expected workload independently of the rollbackable contract root, build
# manifest, and attestation response. SOCKET has the same normalized absolute
# Unix-socket constraints as the checkpoint socket. AUTHORITY_ID begins
# `deployed-workload-attestation-authority:`, KEY_ID begins
# `deployed-workload-attestation-key:`, MEASUREMENT_PROFILE_ID begins
# `deployed-workload-measurement-profile:`, and EXPECTED_WORKLOAD_ID begins
# `workload:`. The public key is canonical Base64 of exactly 32 raw Ed25519
# bytes; its fingerprint and the measurement-profile digest are nonzero
# lowercase `sha256:<64hex>` values. MIN_AUTHORITY_EPOCH and
# MEASUREMENT_PROFILE_VERSION are canonical positive base-10 integers no larger
# than 9,007,199,254,740,991. Startup sends one request containing a fresh nonce,
# computes the digest of its exact canonical bytes, then accepts only a short-
# lived signed response that echoes both values; the proof cannot be replayed as
# a later admission.
# RYUKI_DEPLOYED_WORKLOAD_ATTESTATION_SOCKET=
# RYUKI_DEPLOYED_WORKLOAD_ATTESTATION_AUTHORITY_ID=
# RYUKI_DEPLOYED_WORKLOAD_ATTESTATION_KEY_ID=
# RYUKI_DEPLOYED_WORKLOAD_ATTESTATION_PUBLIC_KEY_BASE64=
# RYUKI_DEPLOYED_WORKLOAD_ATTESTATION_PUBLIC_KEY_FINGERPRINT=
# RYUKI_DEPLOYED_WORKLOAD_ATTESTATION_MIN_AUTHORITY_EPOCH=
# RYUKI_DEPLOYED_WORKLOAD_ATTESTATION_MEASUREMENT_PROFILE_ID=
# RYUKI_DEPLOYED_WORKLOAD_ATTESTATION_MEASUREMENT_PROFILE_VERSION=
# RYUKI_DEPLOYED_WORKLOAD_ATTESTATION_MEASUREMENT_PROFILE_DIGEST=
# RYUKI_EXPECTED_WORKLOAD_ID=

# Production-only public-ingress attestation binding. Configure all nine
# values together; a partial group fails closed, and development/test must
# leave them unset. The authority independently observes the exact API and
# portal HTTPS origins, DNS records, certificate chains, route generation, and
# API backend workload/artifact/instance binding. Its profile must match the
# receipt-bound HttpsPublicUrls expectation exactly. The socket is normalized
# and absolute; IDs begin `public-ingress-attestation-authority:`,
# `public-ingress-attestation-key:`, and `ingress-attestation-profile:`. The
# public key is canonical Base64 for 32 Ed25519 bytes, both digests are nonzero
# lowercase SHA-256 values, and the epoch/version are canonical positive
# integers. Startup performs one fresh nonce-bound exchange without retry.
# RYUKI_PUBLIC_INGRESS_ATTESTATION_SOCKET=
# RYUKI_PUBLIC_INGRESS_ATTESTATION_AUTHORITY_ID=
# RYUKI_PUBLIC_INGRESS_ATTESTATION_KEY_ID=
# RYUKI_PUBLIC_INGRESS_ATTESTATION_PUBLIC_KEY_BASE64=
# RYUKI_PUBLIC_INGRESS_ATTESTATION_PUBLIC_KEY_FINGERPRINT=
# RYUKI_PUBLIC_INGRESS_ATTESTATION_MIN_AUTHORITY_EPOCH=
# RYUKI_PUBLIC_INGRESS_ATTESTATION_PROFILE_ID=
# RYUKI_PUBLIC_INGRESS_ATTESTATION_PROFILE_VERSION=
# RYUKI_PUBLIC_INGRESS_ATTESTATION_PROFILE_DIGEST=

# Production-only PostgreSQL infrastructure attestation binding. Configure all
# nine values together; a partial group fails closed, and development/test must
# leave them unset. Provision this Ed25519 authority, public key, fencing epoch,
# and profile through a trust channel independent of the contract root, build
# manifest, database credentials, and PostgreSQL target. SOCKET is an absolute,
# lexically normalized Unix-socket path with a file name, no NUL, and at most
# 103 path bytes. IDs begin `postgresql-infrastructure-attestation-authority:`,
# `postgresql-infrastructure-attestation-key:`, and
# `postgresql-infrastructure-attestation-profile:`. The public key is canonical
# Base64 for exactly 32 raw Ed25519 bytes; both digests are nonzero lowercase
# `sha256:<64hex>` values; epoch/version are canonical positive integers no
# larger than 9,007,199,254,740,991.
# The PostgreSQL socket path and decoded-key fingerprint must each differ from
# the checkpoint, workload, and ingress authorities. Protocol v2 binds an
# explicit `migration` or `application-serving` purpose alongside the fresh
# nonce in the TLS 1.3 exporter context, request tag, canonical request, and
# signed response.
# The independently governed authority must derive the same purpose-bound
# exporter at the database endpoint and match the deployment pins, receipt-
# bound profile, route, identities, roles, and session exactly; an echoed client
# tag is insufficient. Apply-only relays its one measured channel into one
# direct PgConnection. Application serving instead retains that exact channel,
# its bound loopback relay listener, application-role session, and SQLx pool with configured
# max_connections=min_connections=1; reconnect, fallback, or a wider pool fails
# closed. The pool stays unpublished until the complete eight-guard admission.
# Pre-DDL recheck, every pending migration, exact ledger postflight, and the
# durable operation marker run in one transaction.
# A pre-COMMIT failure rolls back; a lost COMMIT acknowledgement is reported as
# CommitOutcomeUnknown and must be reconciled by a fresh attested run.
# Production apply-only remains disabled before credential loading until live
# Kubernetes render admission, one-use attempt consumption, materialized-pin
# binding, and runtime receipt freshness are implemented.
# RYUKI_POSTGRESQL_INFRASTRUCTURE_ATTESTATION_SOCKET=
# RYUKI_POSTGRESQL_INFRASTRUCTURE_ATTESTATION_AUTHORITY_ID=
# RYUKI_POSTGRESQL_INFRASTRUCTURE_ATTESTATION_KEY_ID=
# RYUKI_POSTGRESQL_INFRASTRUCTURE_ATTESTATION_PUBLIC_KEY_BASE64=
# RYUKI_POSTGRESQL_INFRASTRUCTURE_ATTESTATION_PUBLIC_KEY_FINGERPRINT=
# RYUKI_POSTGRESQL_INFRASTRUCTURE_ATTESTATION_MIN_AUTHORITY_EPOCH=
# RYUKI_POSTGRESQL_INFRASTRUCTURE_ATTESTATION_PROFILE_ID=
# RYUKI_POSTGRESQL_INFRASTRUCTURE_ATTESTATION_PROFILE_VERSION=
# RYUKI_POSTGRESQL_INFRASTRUCTURE_ATTESTATION_PROFILE_DIGEST=

# Production-only first-owner closure authority binding. Configure all five
# values together; a partial group fails closed, and development/test must
# leave them unset. This trust anchor has no authority socket: startup verifies
# the permanent closure certificate stored in PostgreSQL through the exact
# retained DurablePostgresql serving runtime. AUTHORITY_ID begins
# `first-owner-authority:` and KEY_ID begins `first-owner-authority-key:`. The
# public key is canonical Base64 for exactly 32 raw, non-weak Ed25519 bytes;
# its fingerprint is the nonzero lowercase `sha256:<64hex>` digest of those
# decoded bytes; and MIN_EPOCH is a canonical positive base-10 integer no
# larger than 9,007,199,254,740,991. The decoded-key fingerprint must differ
# from the checkpoint, workload, ingress, and PostgreSQL authority keys.
# Startup requires exact canonical certificate bytes and closed schema, a
# valid domain-separated Ed25519 signature at or above the epoch floor, exact
# duplicated database columns, all five privileged-domain assignments, linked
# atomic audit/domain-event evidence, receipt-bound namespace/closure digests,
# and unchanged remeasurement at every applicable serving fence.
# RYUKI_FIRST_OWNER_AUTHORITY_ID=
# RYUKI_FIRST_OWNER_AUTHORITY_KEY_ID=
# RYUKI_FIRST_OWNER_AUTHORITY_PUBLIC_KEY_BASE64=
# RYUKI_FIRST_OWNER_AUTHORITY_PUBLIC_KEY_FINGERPRINT=
# RYUKI_FIRST_OWNER_AUTHORITY_MIN_EPOCH=

# Production apply-only first-owner installation input. Configure this exact
# pair only for the one-shot migration process; ordinary serving/verify-only
# processes do not need and should not retain it. PATH is a normalized absolute
# `.json` path detached from the rollbackable contract root, traversed without
# symlinks and capped at 262,144 bytes. The final node must be a regular file,
# must not be group/other writable, and its provisioning hierarchy must be
# trusted not to substitute device nodes. Kubernetes projected ConfigMap/
# Secret symlink layouts must first be materialized into such a real file by a
# separately verified deployment step. DIGEST is the nonzero lowercase
# `sha256:<64hex>` digest of the exact canonical certificate bytes. The pair is
# forbidden in development/test, and a partial pair fails closed.
# RYUKI_FIRST_OWNER_CLOSURE_CERTIFICATE_PATH=
# RYUKI_FIRST_OWNER_CLOSURE_CERTIFICATE_DIGEST=

# Database
RYUKI_DATABASE_URL=postgres://ryuki:ryuki_dev@localhost:5432/ryuki_platform
# Migration ownership is always explicit. This reference file is for the local
# developer database, where startup may apply the embedded inventory directly.
RYUKI_MIGRATION_MODE=local-auto
# Fail hard when the database is unreachable at startup (exit non-zero instead
# of falling back to in-memory stores). Default false for local dev; set true
# in deployed environments (K8s ConfigMap and compose set it).
# RYUKI_DATABASE__REQUIRED=false

# Server (nested via __)
# Credential-free mock/static authentication is local-only; use a real
# authenticator before selecting a non-loopback listener.
# RYUKI_SERVER__BIND_ADDRESS=127.0.0.1:8080
# RYUKI_SERVER__SHUTDOWN_TIMEOUT_SECS=30
# RYUKI_SERVER__REQUEST_TIMEOUT_SECS=30
# RYUKI_SERVER__MAX_BODY_SIZE_BYTES=10485760
# Production application serving must set both pool counts to 1 so the retained
# SQLx pool cannot outgrow its one independently measured TLS channel. The
# values below are local-development examples.
# RYUKI_SERVER__POOL_MAX_CONNECTIONS=5
# RYUKI_SERVER__POOL_MIN_CONNECTIONS=2
# RYUKI_SERVER__POOL_IDLE_TIMEOUT_SECS=300
# RYUKI_SERVER__POOL_ACQUIRE_TIMEOUT_SECS=30
# RYUKI_SERVER__POOL_MAX_LIFETIME_SECS=1800
# RYUKI_SERVER__TLS_CERT_PATH=/etc/ssl/certs/server.crt
# RYUKI_SERVER__TLS_KEY_PATH=/etc/ssl/private/server.key
# RYUKI_SERVER__COMPRESSION_QUALITY=6      # 0-9
# RYUKI_SERVER__KEEP_ALIVE_TIMEOUT_SECS=75
# RYUKI_SERVER__MAX_CONCURRENT_CONNECTIONS=512

# Auth: mock-dry-run | static-dry-run | entra-id | local
RYUKI_AUTH_MODE=mock-dry-run
RYUKI_ENTRA_TENANT_ID=
RYUKI_ENTRA_CLIENT_ID=
RYUKI_ENTRA_AUTHORITY=https://login.microsoftonline.com
# Browser authorization-code callback. Leave empty only for deliberate
# bearer-token-only Entra use; Entra mode still requires the session verifier.
# RYUKI_ENTRA_REDIRECT_URI=https://portal.example.test/api/auth/entra/callback
# Entra signing-key cache lifetime must be 1..=86400 seconds.
# RYUKI_ENTRA_JWKS_TTL_SECS=86400
# Token clock skew is resolved from the authenticated security-limit profile.
# The retired RYUKI_ENTRA_LEEWAY_SECS input is rejected at startup.

# Reserved generic OIDC inputs. The current runtime has no authenticated
# D/P/Q/R authority for this path, so RYUKI_OIDC__ENABLED=true is rejected at
# startup in every mode. Keep it false until the governed provider-registry
# implementation publishes and retains that exact authority. The remaining
# variables stay documented for configuration-schema compatibility only.
# RYUKI_OIDC__ENABLED=false
# RYUKI_OIDC__ISSUER=https://identity.example.test
# RYUKI_OIDC__AUTHORIZE_ENDPOINT=https://identity.example.test/authorize
# RYUKI_OIDC__TOKEN_ENDPOINT=https://identity.example.test/token
# RYUKI_OIDC__JWKS_URI=https://identity.example.test/jwks
# RYUKI_OIDC__CLIENT_ID=
# RYUKI_OIDC__CLIENT_SECRET=
# RYUKI_OIDC__REDIRECT_URI=https://portal.example.test/api/auth/oidc/callback
# RYUKI_OIDC__SCOPES=["openid","profile","email"]
# RYUKI_OIDC__ROLES_CLAIM=roles

# Local authentication (defensive auth for self-hosted deployments)
# Honored only when RYUKI_AUTH_MODE=local (required and validated at startup
# in that mode; ignored with a warning otherwise).
# Format: comma-separated entries of username:password:Role|Role # secret-scan-allow
#   - exactly 3 ':'-separated fields per entry (passwords must not contain ':')
#   - username: A-Z a-z 0-9 . _ - (unique, case-sensitive)
#   - password: min 8 characters (never echoed in logs or config dumps)
#   - roles: one or more existing app roles separated by '|'
#     (PlatformAdmin, DatacenterApprover, VMwareOperator, HyperVOperator,
#      ProxmoxOperator, WintelLinuxOperator, BackupOperator,
#      MonitoringOperator, ServiceDesk, Auditor, Requester, BreakGlassAdmin)
# Placeholder credentials only — NEVER commit real credentials.
# RYUKI_LOCAL_AUTH__USERS=alice:change-me-password:PlatformAdmin,bob:change-me-password:VMwareOperator|Auditor # secret-scan-allow
# Interactive authority is never inferred from an empty scope. Set each axis
# explicitly to `global` (with an empty value list) or `scoped` (with one or
# more comma-separated canonical identifiers). `unknown` is the fail-closed
# default and prevents a populated local configuration from starting.
# RYUKI_LOCAL_AUTH__SITE_AUTHORITY=global
# RYUKI_LOCAL_AUTH__SITE_SCOPE=
# RYUKI_LOCAL_AUTH__ENVIRONMENT_AUTHORITY=global
# RYUKI_LOCAL_AUTH__ENVIRONMENT_SCOPE=

# Session cookies are Secure by default, which browsers drop over plain HTTP.
# For plain-HTTP local dev, set both RYUKI_PLATFORM_URL to a literal loopback
# HTTP origin and this value to false in your gitignored .env. Startup rejects
# false for HTTPS and every non-loopback public origin.
# RYUKI_SESSION__COOKIE_SECURE=false

# Portal → API upstream and portal runtime mode
# RYUKI_API_URL=http://127.0.0.1:8081
# Exact browser origin admitted for unsafe `/portal/api/*` requests. HTTPS is
# required outside explicitly enabled loopback development.
# RYUKI_PORTAL_PUBLIC_ORIGIN=https://portal.example.test
# RYUKI_PORTAL_ALLOW_INSECURE_LOOPBACK=false
# Bounded portal server-function ingress (hard safety ceilings also apply).
# RYUKI_PORTAL_SERVER_FN_MAX_BODY_BYTES=10485760
# RYUKI_PORTAL_SERVER_FN_MAX_CONCURRENT_REQUESTS=128
# RYUKI_PORTAL_SERVER_FN_REQUEST_TIMEOUT_SECS=30
# Portal execution mode is mandatory and closed: `live-provider` talks to the
# API above; `static-dry-run` is accepted only with an explicitly configured
# loopback RYUKI_PORTAL_PUBLIC_ORIGIN. Missing, blank, unknown, or legacy values
# such as `external-static` fail portal startup.
# RYUKI_PORTAL_EXECUTION_MODE=static-dry-run
# Portal-origin cookie security is derived from RYUKI_PORTAL_PUBLIC_ORIGIN:
# HTTPS always emits Secure cookies; only explicitly enabled loopback HTTP does
# not. This optional value is an assertion and must match the derived policy.
# RYUKI_PORTAL_COOKIE_SECURE=true

# Platform identity
RYUKI_PLATFORM_NAME="Ryuki Infrastructure Platform"
RYUKI_PLATFORM_URL=http://localhost:18080

# Infrastructure providers
# Direct-host live agents also require a stable, non-secret reference to their
# exact vSphere destination/account credential set. Keep these empty for
# dry-run. The id is an opaque provisioning-record reference, never provider
# data; rotate the version whenever any destination/account/credential member
# changes. Provider credentials remain separate runtime-only values.
# RYUKI_LIVE_PROVIDER_AUTHORITY_ID=
# RYUKI_LIVE_PROVIDER_AUTHORITY_VERSION=
# Live agents also require a stable, non-secret reference to the exact backend
# credential/destination authority. The id is kind-scoped; rotate the revision
# whenever its principal, destination, or credential set changes.
# RYUKI_LIVE_BACKEND_CREDENTIAL_AUTHORITY_ID=
# RYUKI_LIVE_BACKEND_CREDENTIAL_AUTHORITY_REVISION=
# Database: cloudnativepg | postgres-local | aws-rds | azure-postgresql | gcp-cloud-sql
RYUKI_DATABASE_PROVIDER=cloudnativepg
# Secrets: hashicorp-vault | aws-secrets-manager | azure-key-vault | gcp-secret-manager | bitwarden-secrets-manager | none
RYUKI_SECRET_PROVIDER=hashicorp-vault
# Production HashiCorp Vault workload-authentication configuration. These are
# exactly twelve non-secret fields: configure all together in production, all
# or none in development/test, and do not add unknown
# RYUKI_SECRET_PROVIDER_RUNTIME__* names. Production validates this closed set
# before reading either projection or contacting Vault. The Deployment projects
# one 600-second, `vault`-audience Kubernetes ServiceAccount JWT and the approved
# CA chain at the two fixed paths below; no bearer or secret value belongs in an
# environment variable.
# RYUKI_SECRET_PROVIDER_RUNTIME__PROVIDER_ID=provider:hashicorp-vault-primary
# RYUKI_SECRET_PROVIDER_RUNTIME__CONFIGURATION_VERSION=1
# RYUKI_SECRET_PROVIDER_RUNTIME__API_FLAVOR=hashicorp-vault-v1
# RYUKI_SECRET_PROVIDER_RUNTIME__ENDPOINT=https://vault.vault.svc:8200
# RYUKI_SECRET_PROVIDER_RUNTIME__CA_BUNDLE_PATH=/var/run/secrets/ryuki/vault-tls/ca.crt
# RYUKI_SECRET_PROVIDER_RUNTIME__KUBERNETES_AUTH_MOUNT=kubernetes
# RYUKI_SECRET_PROVIDER_RUNTIME__KUBERNETES_ROLE=ryuki-platform-api
# RYUKI_SECRET_PROVIDER_RUNTIME__KUBERNETES_AUDIENCE=vault
# RYUKI_SECRET_PROVIDER_RUNTIME__PROJECTED_TOKEN_PATH=/var/run/secrets/ryuki/vault-auth/token
# RYUKI_SECRET_PROVIDER_RUNTIME__EXPECTED_SERVICE_ACCOUNT_NAMESPACE=ryuki-platform
# RYUKI_SECRET_PROVIDER_RUNTIME__EXPECTED_SERVICE_ACCOUNT_NAME=platform-api
# RYUKI_SECRET_PROVIDER_RUNTIME__EXPECTED_TOKEN_POLICY=ryuki-platform-api-runtime

# Separate non-secret selector for the dedicated SecretRef-fingerprint HMAC
# keyring. Production accepts only this fixed path. Its canonical target is a
# regular UTF-8 file inside the fixed parent directory; contained Kubernetes
# projected-volume symlinks are accepted and escaping symlinks fail closed.
# The file is at most 32 KiB, with one to eight unique records in
# exact `key:<id>=<canonical padded standard Base64>` form. Each line is at most
# 512 bytes; an ID is at most 256 bytes, starts with `key:`, has a nonempty
# suffix, and uses only ASCII letters, digits, `:`, `.`, `_`, `-`, and `/`.
# Material decodes to 32-128 bytes. Whitespace, blanks, comments, duplicate IDs,
# and non-canonical encoding fail closed. Rotate with overlap: retain every key
# still named by a stored SecretRef until independent readback proves its
# references were rewritten, restarting the Recreate API Deployment after each
# keyring projection update.
# RYUKI_SECRET_REFERENCE_FINGERPRINT_KEYRING_PATH=/var/run/secrets/ryuki/secret-reference-fingerprint/keyring

# LOCAL DRY-RUN COMPATIBILITY ONLY. The legacy adapter keeps VAULT_ADDR and
# VAULT_TOKEN all-or-none; RYUKI_VAULT_ALLOW_INSECURE_LOOPBACK admits only an
# IP-literal loopback HTTP endpoint. Production rejects the ambient presence of
# any of these variables, even when empty. It also rejects VAULT_TOKEN_FILE,
# VAULT_CACERT, VAULT_NAMESPACE, VAULT_SKIP_VERIFY, VAULT_CLIENT_CERT, and
# VAULT_CLIENT_KEY. None is a fallback for Kubernetes workload authentication.
# VAULT_ADDR=https://vault.example.test:8200
# VAULT_TOKEN=
# RYUKI_VAULT_ALLOW_INSECURE_LOOPBACK=false
# Envelope key for persisted integration credentials: exactly 32 bytes encoded
# as canonical base64 or 64 hex characters, supplied only at runtime.
# RYUKI_INTEGRATION__ENCRYPTION_KEY=
# Durable control-plane grant-signing key path. The file and its parent must be
# owned and protected by the deployment's secret/key delivery mechanism.
# RYUKI_CP_SIGNING_KEY_PATH=/run/secrets/ryuki/cp-signing.key
# Kubernetes: vsphere-vks | docker-compose | aks | eks | gke | openshift | rancher | none
RYUKI_KUBERNETES_RUNTIME=vsphere-vks
# Hypervisor: vmware | hyperv | proxmox | nutanix-ahv | xen | kvm | none
RYUKI_HYPERVISOR_PROVIDER=vmware
# Monitoring: zabbix | prometheus | datadog | grafana | solarwinds | none
RYUKI_MONITORING_PROVIDER=zabbix
# Backup: veeam | commvault | rubrik | cohesity | netbackup | none
RYUKI_BACKUP_PROVIDER=veeam
# Storage: netapp | pure-storage | dell-powerstore | hpe-alletra | azure-blob | none
RYUKI_STORAGE_PROVIDER=none
# DNS: infoblox | bluecat | windows-dns | route53 | none
RYUKI_DNS_PROVIDER=none
# IPAM: infoblox | phpipam | netbox | none
RYUKI_IPAM_PROVIDER=none
# Load Balancer: f5-bigip | citrix-adc | haproxy | nginx | none
RYUKI_LOAD_BALANCER_PROVIDER=none
# Firewall: palo-alto | checkpoint | fortinet | cisco-asa | none
RYUKI_FIREWALL_PROVIDER=none
# Build/CI-CD: jenkins | github-actions | azure-devops | argocd | none
RYUKI_BUILD_PROVIDER=none
# Network/SDN: cisco-aci | vmware-nsx | evpn | none
RYUKI_NETWORK_PROVIDER=none

# CORS (nested via __)
# RYUKI_CORS__ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# RYUKI_CORS__MAX_AGE_SECS=3600

# Rate limiting (nested via __)
# RYUKI_RATE_LIMIT__ENABLED=false
# RYUKI_RATE_LIMIT__REQUESTS_PER_SECOND=50
# RYUKI_RATE_LIMIT__BURST_SIZE=100
# Trusted reverse proxies (plain IPs or CIDR blocks, JSON array like CORS).
# Rate limiting keys on the connecting peer address; X-Forwarded-For is only
# honored when the peer matches one of these networks, taking the rightmost
# entry that is not itself a trusted proxy. Default empty: never trust XFF.
# RYUKI_RATE_LIMIT__TRUSTED_PROXIES=["127.0.0.1","10.0.0.0/8"]

# Per-path rate limit overrides (higher quota for health/metrics endpoints)
# RYUKI_RATE_LIMIT__PATH_OVERRIDES__HEALTH__REQUESTS_PER_SECOND=10
# RYUKI_RATE_LIMIT__PATH_OVERRIDES__HEALTH__BURST_SIZE=5

# Logging (nested via __)
# RYUKI_LOGGING__LEVEL=info         # trace | debug | info | warn | error
# RYUKI_LOGGING__FORMAT=text        # text | json

# Extended logging (file output + retention)
# RYUKI_LOG_EXTENDED__FILE_PATH=/var/log/ryuki-api.log
# RYUKI_LOG_EXTENDED__RETENTION_DAYS=30

# Security headers (nested via __)
# RYUKI_SECURITY__CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'
# RYUKI_SECURITY__HSTS_ENABLED=false
# RYUKI_SECURITY__HSTS_MAX_AGE_SECS=31536000
# Dedicated certificate-pagination cursor HMAC key. Required outside explicit
# credential-free dry-run modes. Inject
# at least 32 random bytes at runtime and never reuse the session verifier key.
# RYUKI_SECURITY__CERTIFICATE_CURSOR_HMAC_KEY=

# SMTP / Email notifications (nested via __)
# RYUKI_SMTP__ENABLED=false
# RYUKI_SMTP__HOST=localhost
# RYUKI_SMTP__PORT=587
# RYUKI_SMTP__USERNAME=
# RYUKI_SMTP__PASSWORD=
# RYUKI_SMTP__FROM_ADDRESS=ryuki@localhost
# RYUKI_SMTP__USE_TLS=true

# Session cookie config (nested via __)
# Required when Local or Entra can mint persisted sessions. A future admitted
# generic-OIDC path will require the same verifier authority.
# Inject at runtime from the selected secret manager; use at least 32 random
# bytes (for example: openssl rand -base64 48). Never commit the value.
# Rotating this single active key intentionally signs out every active session.
# It must be distinct from RYUKI_SECURITY__CERTIFICATE_CURSOR_HMAC_KEY.
# RYUKI_SESSION__CREDENTIAL_HMAC_KEY=
# Browser/local session cookie and server-side maximum age must be 1..=86400
# seconds. For an admitted browser authenticator, the authenticated security-
# limit profile owns this value and startup requires the runtime setting to
# match the resolved limit exactly.
# RYUKI_SESSION__COOKIE_MAX_AGE_SECS=86400
# Maximum age of the last validated federated assertion/lifecycle heartbeat.
# This must be 1..=3600 seconds and no greater than the cookie/session maximum
# age. The security-limit contract resolves and reconciles the exact value.
# Persisted Entra/OIDC sessions fail closed after this interval (default 15m).
# RYUKI_SESSION__FEDERATED_AUTHORITY_MAX_STALENESS_SECS=900
# Browser authorization state has no caller-configurable environment setting.
# Its lifetime is exactly 600 seconds, selected through the authenticated
# security-limit profile and enforced from database-owned time.
# RYUKI_SESSION__COOKIE_SECURE=true
# RYUKI_SESSION__COOKIE_HTTP_ONLY=true
# RYUKI_SESSION__COOKIE_SAME_SITE=lax       # lax | strict | none

# Backup retention (nested via __)
# RYUKI_RETENTION__DAILY_BACKUPS=30       # days to keep daily backups
# RYUKI_RETENTION__WEEKLY_BACKUPS=12      # weeks to keep weekly backups
# RYUKI_RETENTION__MONTHLY_BACKUPS=12     # months to keep monthly backups
# RYUKI_RETENTION__YEARLY_BACKUPS=7       # years to keep yearly backups

# Maintenance window (nested via __)
# RYUKI_MAINTENANCE_WINDOW__ENABLED=false
# RYUKI_MAINTENANCE_WINDOW__DAY_OF_WEEK=sunday     # sunday-saturday
# RYUKI_MAINTENANCE_WINDOW__START_HOUR_UTC=2       # 0-23 (2 = 2 AM UTC)
# RYUKI_MAINTENANCE_WINDOW__DURATION_HOURS=4
