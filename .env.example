# Ryuki Infrastructure Platform — Environment Configuration
# All variables use RYUKI_ prefix with __ (double underscore) for nested fields.
# Example: server.bind_address → RYUKI_SERVER__BIND_ADDRESS
# Priority: env vars > config file > defaults

# Database
RYUKI_DATABASE_URL=postgres://ryuki:ryuki_dev@localhost:5432/ryuki_platform
# Fail hard when the database is unreachable at startup (exit non-zero instead
# of falling back to in-memory stores). Default false for local dev; set true
# in deployed environments (K8s ConfigMap and compose set it).
# RYUKI_DATABASE__REQUIRED=false

# Server (nested via __)
# RYUKI_SERVER__BIND_ADDRESS=0.0.0.0:8080
# RYUKI_SERVER__SHUTDOWN_TIMEOUT_SECS=30
# RYUKI_SERVER__REQUEST_TIMEOUT_SECS=30
# RYUKI_SERVER__MAX_BODY_SIZE_BYTES=10485760
# RYUKI_SERVER__POOL_MAX_CONNECTIONS=5
# RYUKI_SERVER__POOL_MIN_CONNECTIONS=2
# RYUKI_SERVER__POOL_IDLE_TIMEOUT_SECS=300
# RYUKI_SERVER__POOL_ACQUIRE_TIMEOUT_SECS=30
# RYUKI_SERVER__POOL_MAX_LIFETIME_SECS=1800
# RYUKI_SERVER__TLS_CERT_PATH=/etc/ssl/certs/server.crt
# RYUKI_SERVER__TLS_KEY_PATH=/etc/ssl/private/server.key
# RYUKI_SERVER__COMPRESSION_QUALITY=6      # 0-9
# RYUKI_SERVER__KEEP_ALIVE_TIMEOUT_SECS=75
# RYUKI_SERVER__MAX_CONCURRENT_CONNECTIONS=512

# Auth: mock-dry-run | static-dry-run | entra-id | local
RYUKI_AUTH_MODE=mock-dry-run
RYUKI_ENTRA_TENANT_ID=
RYUKI_ENTRA_CLIENT_ID=
RYUKI_ENTRA_AUTHORITY=https://login.microsoftonline.com

# Local authentication (defensive auth for self-hosted deployments)
# Honored only when RYUKI_AUTH_MODE=local (required and validated at startup
# in that mode; ignored with a warning otherwise).
# Format: comma-separated entries of username:password:Role|Role
#   - exactly 3 ':'-separated fields per entry (passwords must not contain ':')
#   - username: A-Z a-z 0-9 . _ - (unique, case-sensitive)
#   - password: min 8 characters (never echoed in logs or config dumps)
#   - roles: one or more existing app roles separated by '|'
#     (PlatformAdmin, DatacenterApprover, VMwareOperator, HyperVOperator,
#      ProxmoxOperator, WintelLinuxOperator, BackupOperator,
#      MonitoringOperator, ServiceDesk, Auditor, Requester, BreakGlassAdmin)
# Placeholder credentials only — NEVER commit real credentials.
# RYUKI_LOCAL_AUTH__USERS=alice:change-me-password:PlatformAdmin,bob:change-me-password:VMwareOperator|Auditor

# Session cookies are Secure by default, which browsers drop over plain HTTP.
# For plain-HTTP local dev (API on http://127.0.0.1) set this to false in your
# gitignored .env — never weaken the default in deployed environments.
# RYUKI_SESSION__COOKIE_SECURE=false

# Portal → API upstream and portal runtime mode
# RYUKI_API_URL=http://127.0.0.1:8081
# Portal execution mode: static-dry-run (GitHub Pages demo, default) or
# live-provider (talks to the API above).
# RYUKI_PORTAL_EXECUTION_MODE=static-dry-run
# Portal-origin session cookie Secure flag: defaults to false for plain-HTTP
# dev; production MUST set this to true.
# RYUKI_PORTAL_COOKIE_SECURE=false

# Platform identity
RYUKI_PLATFORM_NAME="Ryuki Infrastructure Platform"
RYUKI_PLATFORM_URL=http://localhost:18080

# Infrastructure providers
# Database: cloudnativepg | postgres-local | aws-rds | azure-postgresql | gcp-cloud-sql
RYUKI_DATABASE_PROVIDER=cloudnativepg
# Secrets: hashicorp-vault | aws-secrets-manager | azure-key-vault | gcp-secret-manager | bitwarden-secrets-manager | none
RYUKI_SECRET_PROVIDER=hashicorp-vault
# Kubernetes: vsphere-vks | docker-compose | aks | eks | gke | openshift | rancher | none
RYUKI_KUBERNETES_RUNTIME=vsphere-vks
# Hypervisor: vmware | hyperv | proxmox | nutanix-ahv | xen | kvm | none
RYUKI_HYPERVISOR_PROVIDER=vmware
# Monitoring: zabbix | prometheus | datadog | grafana | solarwinds | none
RYUKI_MONITORING_PROVIDER=zabbix
# Backup: veeam | commvault | rubrik | cohesity | netbackup | none
RYUKI_BACKUP_PROVIDER=veeam
# Storage: netapp | pure-storage | dell-powerstore | hpe-alletra | azure-blob | none
RYUKI_STORAGE_PROVIDER=none
# DNS: infoblox | bluecat | windows-dns | route53 | none
RYUKI_DNS_PROVIDER=none
# IPAM: infoblox | phpipam | netbox | none
RYUKI_IPAM_PROVIDER=none
# Load Balancer: f5-bigip | citrix-adc | haproxy | nginx | none
RYUKI_LOAD_BALANCER_PROVIDER=none
# Firewall: palo-alto | checkpoint | fortinet | cisco-asa | none
RYUKI_FIREWALL_PROVIDER=none
# Build/CI-CD: jenkins | github-actions | azure-devops | argocd | none
RYUKI_BUILD_PROVIDER=none
# Network/SDN: cisco-aci | vmware-nsx | evpn | none
RYUKI_NETWORK_PROVIDER=none

# CORS (nested via __)
# RYUKI_CORS__ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
# RYUKI_CORS__MAX_AGE_SECS=3600

# Rate limiting (nested via __)
# RYUKI_RATE_LIMIT__ENABLED=false
# RYUKI_RATE_LIMIT__REQUESTS_PER_SECOND=50
# RYUKI_RATE_LIMIT__BURST_SIZE=100

# Per-path rate limit overrides (higher quota for health/metrics endpoints)
# RYUKI_RATE_LIMIT__PATH_OVERRIDES__HEALTH__REQUESTS_PER_SECOND=10
# RYUKI_RATE_LIMIT__PATH_OVERRIDES__HEALTH__BURST_SIZE=5

# Logging (nested via __)
# RYUKI_LOGGING__LEVEL=info         # trace | debug | info | warn | error
# RYUKI_LOGGING__FORMAT=text        # text | json

# Extended logging (file output + retention)
# RYUKI_LOG_EXTENDED__FILE_PATH=/var/log/ryuki-api.log
# RYUKI_LOG_EXTENDED__RETENTION_DAYS=30

# Security headers (nested via __)
# RYUKI_SECURITY__CONTENT_SECURITY_POLICY=default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'
# RYUKI_SECURITY__HSTS_ENABLED=false
# RYUKI_SECURITY__HSTS_MAX_AGE_SECS=31536000

# SMTP / Email notifications (nested via __)
# RYUKI_SMTP__ENABLED=false
# RYUKI_SMTP__HOST=localhost
# RYUKI_SMTP__PORT=587
# RYUKI_SMTP__USERNAME=
# RYUKI_SMTP__PASSWORD=
# RYUKI_SMTP__FROM_ADDRESS=ryuki@localhost
# RYUKI_SMTP__USE_TLS=true

# Session cookie config (nested via __)
# RYUKI_SESSION__COOKIE_MAX_AGE_SECS=86400
# RYUKI_SESSION__COOKIE_SECURE=true
# RYUKI_SESSION__COOKIE_HTTP_ONLY=true
# RYUKI_SESSION__COOKIE_SAME_SITE=lax       # lax | strict | none

# Backup retention (nested via __)
# RYUKI_RETENTION__DAILY_BACKUPS=30       # days to keep daily backups
# RYUKI_RETENTION__WEEKLY_BACKUPS=12      # weeks to keep weekly backups
# RYUKI_RETENTION__MONTHLY_BACKUPS=12     # months to keep monthly backups
# RYUKI_RETENTION__YEARLY_BACKUPS=7       # years to keep yearly backups

# Maintenance window (nested via __)
# RYUKI_MAINTENANCE_WINDOW__ENABLED=false
# RYUKI_MAINTENANCE_WINDOW__DAY_OF_WEEK=sunday     # sunday-saturday
# RYUKI_MAINTENANCE_WINDOW__START_HOUR_UTC=2       # 0-23 (2 = 2 AM UTC)
# RYUKI_MAINTENANCE_WINDOW__DURATION_HOURS=4
