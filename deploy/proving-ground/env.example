# Proving-ground configuration. Copy to .env in this directory and fill in;
# .env is gitignored. Everything here is read by compose.yaml and
# run-agent.sh. NEVER commit the filled-in file.

# Control-plane stack (Compose)
# Exact committed acceptance revision and immutable IDs recorded from the two
# local images built for that revision. validate.sh checks the local daemon and
# refuses a missing tag, stale label, or changed image ID without pulling.
PG_ACCEPTANCE_REVISION=
PG_PLATFORM_API_IMAGE_ID=
PG_PORTAL_IMAGE_ID=

# Deployment-security admission is mandatory for the API image. Supply a
# reviewed active profile path, its exact raw-byte SHA-256 digest, the expected
# deployment identity, and the explicit profile class. The image fixes the
# contract root at /app/security-contract; these values do not enable live
# provider execution and no repository fixture is selected on your behalf.
PG_DEPLOYMENT_SECURITY_PROFILE_PATH=
PG_DEPLOYMENT_SECURITY_PROFILE_DIGEST=
PG_EXPECTED_DEPLOYMENT_ID=
PG_SECURITY_PROFILE=

# Postgres password for THIS stack (separate volume from the dev stack).
PG_DB_PASSWORD=

# Vault dev-mode root token (in-memory Vault; re-seed secrets on restart).
# It is installed only in the trusted Vault/API namespace; Vault has no host
# port and the separately namespaced portal never receives this value.
PG_VAULT_TOKEN=change-me-vault-root

# Local platform accounts: user:credential:Role|Role, comma-separated users.
# Keep requester and approval duties on distinct principals. Replace both
# placeholder credentials in the gitignored .env before starting the stack.
PG_LOCAL_USERS=requester:change-me-maker:Requester,admin:change-me-checker:PlatformAdmin

# Dedicated verifier for persisted local-auth sessions. Generate at least 32
# random bytes (for example: openssl rand -base64 48); never reuse or commit it.
PG_SESSION_CREDENTIAL_HMAC_KEY=

# Execution agent (run-agent.sh, on the host)
# Enrollment challenge material never belongs here. The explicit
# --stage-enrollment flow obtains one fresh key-bound response at runtime and
# removes it after successful consumption.
# The platform this agent executes for (must match the offering targets).
PG_AGENT_PLATFORM=DEFRA

# Live mode: only the literal "true" unlocks LivePlan/LiveApply/LiveDestroy.
# Leave "false" to rehearse the entire lifecycle dry-run first.
PG_AGENT_ALLOW_LIVE=false

# Approved top-level infrastructure CLIs. Replace these placeholders with
# absolute, already-canonical regular-file paths and the exact first-line
# versions reported by `terraform version` / `ansible-playbook --version`.
# SHA-256 pins may be omitted only while PG_AGENT_ALLOW_LIVE=false. Live mode
# requires both independently approved digests. The scripts copy each tool into
# private agent state, hash it before any version probe, and execute only that
# content-addressed copy.
PG_TERRAFORM_EXECUTABLE=/replace/with/canonical/terraform
PG_TERRAFORM_EXPECTED_VERSION=replace-me
PG_TERRAFORM_EXECUTABLE_SHA256=
PG_ANSIBLE_PLAYBOOK_EXECUTABLE=/replace/with/canonical/ansible-playbook
PG_ANSIBLE_PLAYBOOK_EXPECTED_VERSION=replace-me
PG_ANSIBLE_PLAYBOOK_EXECUTABLE_SHA256=

# vSphere credentials for the live vsphere offerings (declared secret vars).
# Missing/empty values produce a signed refusal naming the variable.
PG_VSPHERE_USER=
PG_VSPHERE_PASSWORD=
PG_VSPHERE_SERVER=

# Stable, non-secret reference to the exact vSphere destination/account
# credential set above. Use an opaque provisioning-record id, never a server,
# account, tenant, credential, or provider-returned value. Rotate the version
# whenever any member of that set changes.
PG_PROVIDER_AUTHORITY_ID=
PG_PROVIDER_AUTHORITY_VERSION=

# Stable, non-secret provisioning reference for the exact local-backend
# credential/destination authority. Keep it empty in dry-run mode. Live mode
# requires a kind-scoped opaque id and immutable v-prefixed revision; rotate
# the revision whenever the backend principal, destination, or credential set
# changes.
PG_BACKEND_CREDENTIAL_AUTHORITY_ID=
PG_BACKEND_CREDENTIAL_AUTHORITY_REVISION=

# Durable local Terraform state backend HCL (written into each live workspace
# before init). REQUIRED for a meaningful apply->destroy test: without it,
# state does not persist and a teardown finds nothing to destroy. Keep this
# proving-ground value unchanged. The agent replaces {STATE_KEY} with the
# isolated request/step state key and {STATE_DIR} with the absolute
# agent-state path.
PG_AGENT_BACKEND_HCL=terraform { backend "local" { path = "{STATE_DIR}/terraform-{STATE_KEY}.tfstate" } }
