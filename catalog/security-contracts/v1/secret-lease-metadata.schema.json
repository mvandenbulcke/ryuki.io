{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryuki.io/schemas/security-contracts/v1/secret-lease-metadata.schema.json",
  "title": "Ryuki Secret Lease Metadata",
  "description": "Closed, value-free wire contract for provider-qualified secret lease metadata. Lifecycle branches require the exact issued and terminal fields serialized by SecretLeaseMetadata; timestamp ordering is additionally enforced by the typed decoder.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "referenceFingerprint",
    "fingerprintKeyId",
    "providerId",
    "providerConfigVersion",
    "adapterCapabilityVersion",
    "deploymentId",
    "trustDomainId",
    "workloadId",
    "purpose",
    "resolutionMode",
    "revocationOwner",
    "authorityEpoch",
    "fencingToken",
    "lifecycleState"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "referenceFingerprint": { "$ref": "#/$defs/referenceFingerprint" },
    "fingerprintKeyId": { "$ref": "#/$defs/fingerprintKeyId" },
    "providerId": { "$ref": "#/$defs/providerId" },
    "providerConfigVersion": { "$ref": "#/$defs/positiveU64" },
    "adapterCapabilityVersion": { "$ref": "#/$defs/canonicalIdentifier" },
    "deploymentId": { "$ref": "#/$defs/deploymentId" },
    "trustDomainId": { "$ref": "#/$defs/trustDomainId" },
    "tenantId": { "$ref": "#/$defs/canonicalIdentifier" },
    "workloadId": { "$ref": "#/$defs/workloadId" },
    "purpose": { "$ref": "#/$defs/purposeId" },
    "resolutionMode": {
      "enum": ["pinned", "latest-at-resolve"]
    },
    "requestedVersion": { "$ref": "#/$defs/canonicalIdentifier" },
    "revocationOwner": {
      "enum": ["provider", "workload-runtime"]
    },
    "requestId": { "$ref": "#/$defs/canonicalIdentifier" },
    "jobId": { "$ref": "#/$defs/canonicalIdentifier" },
    "authorityEpoch": { "$ref": "#/$defs/positiveU64" },
    "fencingToken": { "$ref": "#/$defs/positiveU64" },
    "lifecycleState": {
      "enum": [
        "requested",
        "issued",
        "active",
        "renewing",
        "draining",
        "revoked",
        "expired",
        "failed"
      ]
    },
    "leaseId": { "$ref": "#/$defs/canonicalIdentifier" },
    "resolvedVersion": { "$ref": "#/$defs/canonicalIdentifier" },
    "issuedAt": { "$ref": "#/$defs/timestamp" },
    "expiresAt": { "$ref": "#/$defs/timestamp" },
    "terminalAt": { "$ref": "#/$defs/timestamp" }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "resolutionMode": { "const": "pinned" }
          },
          "required": ["requestedVersion"]
        },
        {
          "properties": {
            "resolutionMode": { "const": "latest-at-resolve" }
          },
          "not": { "required": ["requestedVersion"] }
        }
      ]
    },
    {
      "anyOf": [
        { "required": ["requestId"] },
        { "required": ["jobId"] }
      ]
    },
    {
      "oneOf": [
        {
          "properties": {
            "lifecycleState": { "const": "requested" }
          },
          "not": {
            "anyOf": [
              { "required": ["leaseId"] },
              { "required": ["resolvedVersion"] },
              { "required": ["issuedAt"] },
              { "required": ["expiresAt"] },
              { "required": ["terminalAt"] }
            ]
          }
        },
        {
          "properties": {
            "lifecycleState": {
              "enum": ["issued", "active", "renewing", "draining"]
            }
          },
          "required": ["leaseId", "resolvedVersion", "issuedAt", "expiresAt"],
          "not": { "required": ["terminalAt"] }
        },
        {
          "properties": {
            "lifecycleState": { "enum": ["revoked", "expired"] }
          },
          "required": [
            "leaseId",
            "resolvedVersion",
            "issuedAt",
            "expiresAt",
            "terminalAt"
          ]
        },
        {
          "properties": {
            "lifecycleState": { "const": "failed" }
          },
          "required": ["terminalAt"],
          "oneOf": [
            {
              "not": {
                "anyOf": [
                  { "required": ["leaseId"] },
                  { "required": ["resolvedVersion"] },
                  { "required": ["issuedAt"] },
                  { "required": ["expiresAt"] }
                ]
              }
            },
            {
              "required": ["leaseId", "resolvedVersion", "issuedAt", "expiresAt"]
            }
          ]
        }
      ]
    }
  ],
  "$defs": {
    "positiveU64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "canonicalIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9:._/-]+$"
    },
    "providerId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^provider:[A-Za-z0-9:._/-]+$"
    },
    "deploymentId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^deployment:[A-Za-z0-9:._/-]+$"
    },
    "trustDomainId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^trust-domain:[A-Za-z0-9:._/-]+$"
    },
    "workloadId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^workload:[A-Za-z0-9:._/-]+$"
    },
    "purposeId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^purpose:[A-Za-z0-9:._/-]+$"
    },
    "fingerprintKeyId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^key:[A-Za-z0-9:._/-]+$"
    },
    "referenceFingerprint": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  }
}
