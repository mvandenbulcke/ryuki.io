{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ryuki.io/schemas/security-contracts/v1/secret-ref.schema.json",
  "title": "Ryuki Runtime Secret Reference",
  "description": "Closed, value-free wire contract for one provider-qualified runtime SecretRef. Optional selector fields are omitted when absent; secret material is never represented by this contract.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "providerId",
    "providerConfigVersion",
    "deploymentId",
    "trustDomainId",
    "referenceFingerprint",
    "fingerprintKeyId",
    "opaqueLocator",
    "purpose",
    "versionSelector"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "providerId": { "$ref": "#/$defs/providerId" },
    "providerConfigVersion": { "$ref": "#/$defs/positiveU64" },
    "deploymentId": { "$ref": "#/$defs/deploymentId" },
    "trustDomainId": { "$ref": "#/$defs/trustDomainId" },
    "tenantId": { "$ref": "#/$defs/canonicalIdentifier" },
    "referenceFingerprint": { "$ref": "#/$defs/referenceFingerprint" },
    "fingerprintKeyId": { "$ref": "#/$defs/fingerprintKeyId" },
    "opaqueLocator": { "$ref": "#/$defs/opaqueLocator" },
    "fieldSelector": { "$ref": "#/$defs/opaqueSelector" },
    "purpose": { "$ref": "#/$defs/purposeId" },
    "versionSelector": { "$ref": "#/$defs/versionSelector" }
  },
  "$defs": {
    "positiveU64": {
      "type": "integer",
      "minimum": 1,
      "maximum": 18446744073709551615
    },
    "canonicalIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9:._/-]+$"
    },
    "providerId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^provider:[A-Za-z0-9:._/-]+$"
    },
    "deploymentId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^deployment:[A-Za-z0-9:._/-]+$"
    },
    "trustDomainId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^trust-domain:[A-Za-z0-9:._/-]+$"
    },
    "purposeId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^purpose:[A-Za-z0-9:._/-]+$"
    },
    "fingerprintKeyId": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^key:[A-Za-z0-9:._/-]+$"
    },
    "referenceFingerprint": {
      "type": "string",
      "pattern": "^hmac-sha256:[0-9a-f]{64}$"
    },
    "opaqueLocator": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f-\\u009f]).+$"
    },
    "opaqueSelector": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?!\\s)(?!.*\\s$)(?!.*[\\u0000-\\u001f\\u007f-\\u009f]).+$"
    },
    "versionSelector": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "secretVersion"],
          "properties": {
            "kind": { "const": "pinned" },
            "secretVersion": { "$ref": "#/$defs/canonicalIdentifier" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "const": "latest-at-resolve" }
          }
        }
      ]
    }
  }
}
